# IDE / editor
.idea/
.vscode/
*.swp
*~
*.code-workspace

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Local agent / MCP / indexing / Spec Kit (machine-local, do not commit)
terminals/
mcps/
mcp/
.mcp/
.codegraph/
.zcode/
