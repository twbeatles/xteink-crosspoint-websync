# Debug one-off scripts (local only; do not commit)
scripts/_debug_*.py
scripts/_tmp_*.py

# Lock / PID / runtime sidecars (machine-local)
*.lock
*.pid
*.lockfile
x3_websync_pipeline.lock
x3_websync_instance.lock

# Auto-update staging (downloaded exe / helper / last-update-result)
.updates/

# Scraper validation dumps (local artifacts)
output/scraper_validation.json
*.scraper_validation.json
